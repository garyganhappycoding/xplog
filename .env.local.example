    NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Groq API key (https://console.groq.com/keys): diary auto-tagging and the Telegram bot
GROQ_API_KEY=
# Optional: override the default models if Groq retires one
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Notion integration, used server-side by /api/sync-idea to push diary entries
# tagged "idea" into your Idea Vault database
NOTION_API_KEY=
NOTION_IDEA_VAULT_DATA_SOURCE_ID=

# --- Telegram bot (see README: "Telegram 机器人 + 记忆库") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Leave empty at first; the bot replies with your chat id, then fill it in and redeploy
TELEGRAM_ALLOWED_CHAT_ID=
# The whole service-account JSON file, pasted as one value (server-side only, never commit it)
FIREBASE_SERVICE_ACCOUNT=
# The Google account you sign in to XPLog with (or set XPLOG_OWNER_UID instead)
XPLOG_OWNER_EMAIL=
XPLOG_TIMEZONE=Asia/Kuala_Lumpur
