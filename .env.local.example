    NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Groq API key (https://console.groq.com/keys): the Telegram bot, parsing, and voice-to-text
GROQ_API_KEY=
# Optional: override the default models if Groq retires one
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Notion integration, used server-side: every diary entry, and dump items you sort into
# 想法 / 笔记 / 链接, are written to your Idea Vault database
NOTION_API_KEY=
NOTION_IDEA_VAULT_DATA_SOURCE_ID=

# --- Telegram bot (see README: "Telegram 机器人 + 记忆库") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Leave empty at first; the bot replies with your chat id, then fill it in and redeploy
TELEGRAM_ALLOWED_CHAT_ID=
# The whole service-account JSON file, pasted as one value (server-side only, never commit it)
FIREBASE_SERVICE_ACCOUNT=
# The Google account you sign in to XPLog with (or set XPLOG_OWNER_UID instead)
XPLOG_OWNER_EMAIL=
XPLOG_TIMEZONE=Asia/Kuala_Lumpur

# --- Reminders (the bot messages you first) ---
# Any long random string. The scheduler must send it as "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron does this automatically).
CRON_SECRET=
# Optional: minutes before a timed event to remind you (default 30) and the hour of the morning summary (default 8)
# REMINDER_EVENT_MINUTES=30
# DIGEST_HOUR=8

# --- Web search for the assistant (https://tavily.com, free tier) ---
TAVILY_API_KEY=

# --- Google Calendar two-way sync (see README: "Google 日历双向同步") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if the redirect address is not https://<your domain>/api/google/callback
# GOOGLE_REDIRECT_URI=

# --- Link in the 22:30 bedtime message (default https://xplog.vercel.app) ---
# APP_URL=https://xplog.vercel.app
